# AI 网关（fox）—— Anthropic 原生协议
ANTHROPIC_API_KEY=your_key
ANTHROPIC_BASE_URL=https://code.newcli.com/claude/aws
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5-20251001

# Jimaku 字幕 API
JIMAKU_API_TOKEN=your_token

# 数据库
# 本地非容器开发(默认):
DATABASE_URL=sqlite:///./data/anime-nihongo.db
# 生产/容器(docker-compose 用):
# DATABASE_URL=postgresql+psycopg://anime:anime@db:5432/anime
POSTGRES_USER=anime
POSTGRES_PASSWORD=anime
POSTGRES_DB=anime

# VOICEVOX 本地 TTS（默认即可，启动 VOICEVOX.app 后自动监听 50021）
VOICEVOX_URL=http://localhost:50021

# 生产必须使用随机强密钥，例如: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_64_character_secret
REQUIRE_AUTH=false

# 共享 Caddy 上的 trading.narutoooo.com Basic Auth
# 哈希由 `caddy hash-password` 或 `htpasswd -nbB` 生成。
TRADING_BASIC_AUTH_USER=trader
TRADING_BASIC_AUTH_HASH='$2y$05$replace_with_bcrypt_hash'
